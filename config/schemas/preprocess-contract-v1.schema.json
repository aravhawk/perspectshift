{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perceptshift.dev/schemas/preprocess-contract-v1.schema.json",
  "title": "PerceptShift Canonical Preprocess Contract v1",
  "description": "Schema-backed preprocessing contract shared by Forge, native ProfileExecutor, and runtime profiles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_width",
    "input_height",
    "input_layout",
    "accepted_source_formats",
    "resize_mode",
    "resize_interpolation",
    "scale",
    "mean",
    "std",
    "swap_rb",
    "output_dtype",
    "backend"
  ],
  "properties": {
    "input_width": {
      "type": "integer",
      "minimum": 1
    },
    "input_height": {
      "type": "integer",
      "minimum": 1
    },
    "input_layout": {
      "enum": ["nchw", "nhwc"]
    },
    "accepted_source_formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["rgb8", "bgr8", "rgba8", "bgra8", "mono8"]
      }
    },
    "source_color_handling": {
      "enum": ["preserve", "convert_to_rgb"],
      "default": "convert_to_rgb"
    },
    "resize_mode": {
      "enum": ["stretch"],
      "description": "v1 supports stretch resize only. Letterbox is rejected until explicitly implemented."
    },
    "resize_interpolation": {
      "enum": ["bilinear"]
    },
    "scale": {
      "type": "number"
    },
    "mean": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "std": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "swap_rb": {
      "type": "boolean",
      "description": "After source-format conversion to RGB plane order, optionally swap R/B channels."
    },
    "letterbox_pad_value": {
      "type": ["number", "null"],
      "description": "Unused in v1 stretch mode; must be null when resize_mode is stretch."
    },
    "output_dtype": {
      "enum": ["float32"]
    },
    "backend": {
      "enum": ["scalar", "neon_auto", "neon"]
    }
  }
}
