# syntax=docker/dockerfile:1.7
# Local operational API in artifact-store mode.
# This image does not contain ROS 2 Jazzy or perceptshift_msgs; it is not ROS-connected.
FROM python:3.14-slim-bookworm AS build
WORKDIR /src
COPY python /src/python
COPY config /src/config
RUN pip install --no-cache-dir build \
    && pip wheel --no-deps -w /wheels \
       /src/python/perceptshift_common \
       /src/python/perceptshift_api \
    && test -n "$(ls -A /wheels/*.whl 2>/dev/null)"

FROM python:3.14-slim-bookworm
RUN useradd --system --create-home --uid 10002 --shell /usr/sbin/nologin perceptshift-api \
    && mkdir -p /var/lib/perceptshift/state /var/lib/perceptshift/data /etc/perceptshift \
    && chown -R perceptshift-api:perceptshift-api /var/lib/perceptshift

COPY --from=build /wheels /wheels
RUN pip install --no-cache-dir /wheels/*.whl \
    && rm -rf /wheels

ENV PERCEPTSHIFT_API_ENABLE_ROS=false \
    HOME=/var/lib/perceptshift \
    XDG_STATE_HOME=/var/lib/perceptshift/state \
    XDG_DATA_HOME=/var/lib/perceptshift/data

USER perceptshift-api
WORKDIR /var/lib/perceptshift
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/api/v1/healthz')" || exit 1

LABEL org.opencontainers.image.title="perceptshift-api" \
      org.opencontainers.image.description="PerceptShift local artifact-store API (ROS unavailable in this image)" \
      org.opencontainers.image.licenses="Apache-2.0"

CMD ["python", "-m", "perceptshift_api", "--host", "0.0.0.0", "--port", "8080"]
