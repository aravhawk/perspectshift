# syntax=docker/dockerfile:1.7
# Local operational API in artifact-store mode.
# This image does not contain ROS 2 Jazzy or perceptshift_msgs; it is not ROS-connected.
# Ubuntu 24.04 matches the runtime image OS that already passes HIGH/CRITICAL scans.
FROM ubuntu:26.04 AS build
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /src
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY python /src/python
COPY config /src/config
RUN python3 -m venv /opt/build-venv \
    && /opt/build-venv/bin/pip install --no-cache-dir build \
    && /opt/build-venv/bin/pip wheel --no-deps -w /wheels \
       /src/python/perceptshift_common \
       /src/python/perceptshift_api \
    && test -n "$(ls -A /wheels/*.whl 2>/dev/null)"

FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ca-certificates \
    && useradd --system --create-home --uid 10002 --shell /usr/sbin/nologin perceptshift-api \
    && mkdir -p /var/lib/perceptshift/state /var/lib/perceptshift/data /etc/perceptshift \
                 /opt/perceptshift \
    && python3 -m venv /opt/perceptshift/venv \
    && chown -R perceptshift-api:perceptshift-api /var/lib/perceptshift /opt/perceptshift \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /wheels /wheels
RUN /opt/perceptshift/venv/bin/pip install --no-cache-dir /wheels/*.whl \
    && rm -rf /wheels \
    && chown -R perceptshift-api:perceptshift-api /opt/perceptshift/venv

ENV PERCEPTSHIFT_API_ENABLE_ROS=false \
    HOME=/var/lib/perceptshift \
    XDG_STATE_HOME=/var/lib/perceptshift/state \
    XDG_DATA_HOME=/var/lib/perceptshift/data \
    PATH="/opt/perceptshift/venv/bin:${PATH}"

USER perceptshift-api
WORKDIR /var/lib/perceptshift
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD /opt/perceptshift/venv/bin/python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/api/v1/healthz')" || exit 1

LABEL org.opencontainers.image.title="perceptshift-api" \
      org.opencontainers.image.description="PerceptShift local artifact-store API (ROS unavailable in this image)" \
      org.opencontainers.image.licenses="Apache-2.0"

CMD ["/opt/perceptshift/venv/bin/python", "-m", "perceptshift_api", "--host", "0.0.0.0", "--port", "8080"]
