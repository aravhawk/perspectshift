# syntax=docker/dockerfile:1.7
# Static operational console with security headers. No development server.
FROM node:24-bookworm AS build
WORKDIR /src
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY web /src/web
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate \
    && pnpm install --frozen-lockfile \
    && pnpm --filter perceptshift-console build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY --from=build /src/web/dist /usr/share/nginx/html
COPY deploy/containers/console.nginx.conf /etc/nginx/conf.d/default.conf
USER 101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1

LABEL org.opencontainers.image.title="perceptshift-console" \
      org.opencontainers.image.description="PerceptShift operational console static assets" \
      org.opencontainers.image.licenses="Apache-2.0"
