# syntax=docker/dockerfile:1.7
# Development image with full toolchain. Not for production.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git curl ca-certificates pkg-config \
    python3 python3-venv python3-pip clang clang-tidy clang-format \
    libssl-dev zlib1g-dev jq ripgrep sudo \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash --uid 1000 developer \
    && mkdir -p /workspace \
    && chown developer:developer /workspace

USER developer
WORKDIR /workspace

LABEL org.opencontainers.image.title="perceptshift-dev" \
      org.opencontainers.image.description="PerceptShift development toolchain" \
      org.opencontainers.image.licenses="Apache-2.0"
