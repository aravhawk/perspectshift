<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perceptshift_ros</name>
  <version>0.1.0</version>
  <description>
    ROS 2 Jazzy lifecycle component that transports frames, lifecycle commands,
    and diagnostics for PerceptShift. Inference logic lives in libperceptshift_core.
  </description>
  <maintainer email="maintainers@perceptshift.local">PerceptShift Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rclcpp_components</depend>
  <depend>lifecycle_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>perceptshift_msgs</depend>
  <depend>image_transport</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rclcpp_components plugin="${prefix}/perceptshift_components.xml"/>
  </export>
</package>
