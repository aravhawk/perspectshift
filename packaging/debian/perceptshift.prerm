#!/bin/sh
set -e

case "$1" in
  remove|upgrade|deconfigure)
    if command -v systemctl >/dev/null 2>&1; then
      systemctl stop perceptshift-api.service >/dev/null 2>&1 || true
      systemctl stop perceptshift-runtime.service >/dev/null 2>&1 || true
      systemctl disable perceptshift-api.service >/dev/null 2>&1 || true
      systemctl disable perceptshift-runtime.service >/dev/null 2>&1 || true
    fi
    ;;
esac

#DEBHELPER#
exit 0
